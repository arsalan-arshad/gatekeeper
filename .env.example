# Postgres (Railway Hobby + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatekeeper

# LLM — gemini (default) | groq | xai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# Optional tuning
# LLM_DAILY_LIMIT=50
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=2
# GROQ_MODEL=llama-3.1-8b-instant
# XAI_MODEL=grok-2-latest

# Email (Resend) — omit locally to log magic links (web) and opt-in mail (API) to consoles
RESEND_API_KEY=
EMAIL_FROM=Gatekeeper <onboarding@resend.dev>
# Optional override for signed Accept/Decline links (defaults to AUTH_SECRET)
# EMAIL_LINK_SECRET=

# Public app URL (web)
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
