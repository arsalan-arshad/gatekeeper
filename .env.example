# Postgres (Railway Hobby + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatekeeper

# LLM — Gemini first, Groq failover (only providers with keys are used)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# Optional tuning
# LLM_DAILY_LIMIT=50
# LLM_TIMEOUT_MS=8000
# LLM_MAX_RETRIES=0

# Admin probe: GET /health/llm?token=...
ADMIN_TOKEN=

# Email (Resend) — omit locally to log magic links (web) and opt-in mail (API) to consoles
RESEND_API_KEY=
EMAIL_FROM=Gatekeeper <onboarding@resend.dev>
# Optional override for signed Accept/Decline links (defaults to AUTH_SECRET)
# EMAIL_LINK_SECRET=

# Public app URL (web)
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Shared server-to-server auth (set the SAME value on api + web). Never NEXT_PUBLIC_*.
# Short-lived HS256 JWTs (sub=email, exp<=60s) for /v1/dashboard|api-keys|onboarding|payments.
INTERNAL_API_SECRET=replace-with-a-long-random-shared-secret

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Payments (Lemon Squeezy) — off by default. Without keys, billing UI shows "Coming soon".
PAYMENTS_ENABLED=false
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_PRO_VARIANT_ID=
LEMON_SQUEEZY_CREDITS_VARIANT_ID=

# Creator credit (optional overrides for footer / landing)
# NEXT_PUBLIC_GITHUB_URL=https://github.com/arsalan-arshad/gatekeeper
# NEXT_PUBLIC_X_URL=https://x.com/arsalanadev
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/arsalanadev
# NEXT_PUBLIC_CREATOR_BIO=
# NEXT_PUBLIC_CREATOR_AVATAR_URL=/brand/creator-avatar.svg

# Playwright e2e — enables Credentials provider id=e2e when set
# E2E_SECRET=local-e2e-secret

# Optional tuning (cents)
# STAKE_CENTS=100
# INTRO_CREDIT_CENTS=500
# CREDITS_PACK_CENTS=2500
# FREE_INBOX_LIMIT=1
# PRO_INBOX_LIMIT=5
