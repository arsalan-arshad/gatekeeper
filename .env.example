# Postgres (Railway Hobby + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatekeeper

# LLM — gemini (default) | groq | xai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# Optional tuning
# LLM_DAILY_LIMIT=50
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=2
# GROQ_MODEL=llama-3.1-8b-instant
# XAI_MODEL=grok-2-latest

# Email (Resend)
RESEND_API_KEY=

# Public app URL (web)
APP_URL=http://localhost:3000
