  "views": {
    "public.ledger_stats": {
      "columns": {
        "target_user_id": {
          "name": "target_user_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "month": {
          "name": "month",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true
        },
        "request_count": {
          "name": "request_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "accept_count": {
          "name": "accept_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "reject_count": {
          "name": "reject_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "spam_count": {
          "name": "spam_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "accept_rate": {
          "name": "accept_rate",
          "type": "double precision",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    SELECT\n      target_user_id,\n      date_trunc('month', created_at) AS month,\n      count(*)::int AS request_count,\n      count(*) FILTER (WHERE decision = 'accept')::int AS accept_count,\n      count(*) FILTER (WHERE decision = 'reject')::int AS reject_count,\n      count(*) FILTER (WHERE decision = 'spam')::int AS spam_count,\n      CASE\n        WHEN count(*) = 0 THEN 0::float8\n        ELSE (count(*) FILTER (WHERE decision = 'accept'))::float8 / count(*)::float8\n      END AS accept_rate\n    FROM requests\n    GROUP BY target_user_id, date_trunc('month', created_at)\n  ",
      "name": "ledger_stats",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
