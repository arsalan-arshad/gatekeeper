    "fastify": "^5.2.1",
    "resend": "^6.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gatekeeper/tsconfig": "workspace:*",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
